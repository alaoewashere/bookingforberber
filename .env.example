NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Use a unique password manager-generated value with at least 20 characters.
ADMIN_PASSWORD=replace_with_a_unique_20_plus_character_password
# The one email address permitted to complete the second login factor.
ADMIN_EMAIL=your-admin-email@example.com
# Server-only signing key for the anonymous booking-device cookie. Generate a
# long random value; it must not be exposed to the browser.
BOOKING_DEVICE_SECRET=replace_with_a_unique_random_server_only_value
# Server-only secret Vercel uses to authorize the daily data-retention Cron.
CRON_SECRET=replace_with_a_unique_random_server_only_value
# Optional anti-abuse tuning. Defaults are 8 booking attempts per IP/device per
# 3,600-second window, and 90 days of IP/device retention.
BOOKING_IP_RATE_LIMIT_WINDOW_SECONDS=3600
BOOKING_IP_RATE_LIMIT_MAX=8
BOOKING_ABUSE_RETENTION_DAYS=90
